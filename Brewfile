

# Install eza, a modern replacement for ls
brew "eza"

# Install yazi, a blazing fast terminal file manager
brew "yazi"

# Install jq, a lightweight and flexible command-line JSON processor
brew "jq"

# Install glow, a terminal-based markdown reader
brew "glow"

# Install fzf, a command-line fuzzy finder
brew "fzf"

# Install gitmoji, a CLI tool for using emojis in Git commits
brew "gitmoji"

# Install zoxide, a smarter cd command
brew "zoxide"

# Install 7z, a file archiver with high compression ratio
brew "p7zip"

# Install ripgrep, a line-oriented search tool
brew "ripgrep"

# Install fd, a simple, fast and user-friendly alternative to find
brew "fd"

# Install exiftool, a platform-independent Perl library plus a command-line application for reading, writing and editing meta information in a wide variety of files
brew "exiftool"

# Install imagemagick, a software suite to create, edit, compose, or convert bitmap images
brew "imagemagick"

# Install lazygit, a simple terminal UI for git commands
brew "lazygit"

# Install resvg, a high-performance SVG rendering library
brew "resvg"
